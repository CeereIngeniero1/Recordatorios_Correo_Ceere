# Configuración de base de datos SQL Server
DB_USER=tu_usuario_sql
DB_PASSWORD=tu_contraseña_sql
DB_SERVER=tu_servidor_sql
DB_NAME=nombre_de_tu_base_de_datos

# Configuración de Correo (SMTP)
EMAIL_HOST=smtp.ejemplo.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=tu_correo@ejemplo.com
EMAIL_PASS=tu_contraseña
EMAIL_FROM="Notificaciones" <tu_correo@ejemplo.com>
# En puerto 465 usa EMAIL_SECURE=true. No uses EMAIL_TLS_CIPHERS=SSLv3 con nodemailer moderno.

# Slogan opcional en el encabezado del correo (nombre, teléfono y dirección salen de Empresa / EmpresaIII)
CLINICA_SLOGAN=

# Configuración de pruebas para Correo
# Si EMAIL_TEST_MODE es true, todos los correos se redirigen a EMAIL_TEST_ADDRESS
EMAIL_TEST_MODE=false
EMAIL_TEST_ADDRESS=correo_de_pruebas@correo.com

# Intervalo de revisión en minutos (recomendado: 5 o 10)
POLLING_INTERVAL_MINUTES=10

# Minutos de espera si el servidor SMTP bloquea la cuenta por exceso de envíos
SMTP_LIMIT_WAIT_MINUTES=60

# Horario opcional de envío (hora local, 0-23). Si se omiten, revisa todo el día.
# HORARIO_INICIO=8
# HORARIO_FIN=20

# Timeouts SQL (ms). Por defecto: consulta 120s, conexión 30s
DB_REQUEST_TIMEOUT_MS=120000
DB_CONNECTION_TIMEOUT_MS=30000

# Ritmo de envío (opcional). Si no se definen, el bot elige según el tamaño del lote.
# EMAIL_DELAY_MIN_MS=20000
# EMAIL_DELAY_MAX_MS=40000
